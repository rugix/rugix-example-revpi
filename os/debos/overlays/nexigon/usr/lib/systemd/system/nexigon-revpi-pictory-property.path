[Unit]
Description=Watch the RevPi PiCtory Configuration

[Path]
PathChanged=/var/www/revpi/pictory/projects/_config.rsc
PathChanged=/run/nexigon/agent/control/socket.sock
Unit=nexigon-revpi-pictory-property.service

[Install]
WantedBy=multi-user.target
